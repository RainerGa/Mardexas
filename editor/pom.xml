<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>de.richmarkdown</groupId>
  <artifactId>RichMarkDownEditor</artifactId>
  <version>1.1.0</version>
  <name>RichMarkDownEditor</name>
  <description>Word-ähnlicher WYSIWYG-Markdown-Editor auf Basis von rich-text-area</description>
  <licenses>
    <license>
      <name>GNU General Public License, Version 3</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <!-- Override for isolated GUI checks while Eclipse builds target/classes. -->
    <mardexas.build.directory>${project.basedir}/target</mardexas.build.directory>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <javafx.version>25.0.4</javafx.version>
    <richtextarea.version>3.5-RG</richtextarea.version>
    <junit.version>5.11.3</junit.version>
    <testfx.version>4.0.19-gluon</testfx.version>
    <monocle.version>21.0.2</monocle.version>
    <surefire.version>3.2.5</surefire.version>
    <test.forkCount>2</test.forkCount>
    <mainClass>de.richmarkdown.Launcher</mainClass>
  </properties>

  <!-- Gluon-Nexus: Quelle der "-gluon"-TestFX-Artefakte (testfx-core /
       testfx-junit5 : 4.0.19-gluon). Diese Builds liegen NICHT auf Maven
       Central. Ist das Repository nicht deklariert, versucht Maven/m2e die
       Auflösung gegen Central, schlägt fehl und meldet die lokal vorhandenen
       Artefakte fälschlich als "Missing artifact" (über .lastUpdated-Marker).
       Die <id> muss zu _remote.repositories passen ("Gluon Releases"). -->
  <repositories>
    <repository>
      <id>Gluon Releases</id>
      <name>Gluon Releases</name>
      <url>https://nexus.gluonhq.com/nexus/content/repositories/releases/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- JavaFX 25.0.4 (offline in ~/.m2; fxml wird nicht benötigt) -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- The rich-text-area dependency is supplied by the sibling Maven reactor
         module from the pinned main-branch commit in the Git submodule. -->
    <dependency>
      <groupId>com.gluonhq</groupId>
      <artifactId>rich-text-area</artifactId>
      <version>${richtextarea.version}</version>
      <exclusions>
        <!-- Also reject the old artifacts when a stale fork is installed locally. -->
        <exclusion><groupId>com.gluonhq.emoji</groupId><artifactId>emoji</artifactId></exclusion>
        <exclusion><groupId>com.gluonhq.emoji</groupId><artifactId>offline</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>de.richmarkdown</groupId>
      <artifactId>emoji-noto</artifactId>
      <version>1.1.0-mardexas-1</version>
    </dependency>

    <!-- Test: JUnit 5 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Test: TestFX + openjfx-monocle (headless UI-Tests) -->
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-core</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>openjfx-monocle</artifactId>
      <version>${monocle.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource>
        <directory>../packaging/licenses</directory>
        <targetPath>META-INF/licenses</targetPath>
      </resource>
    </resources>
    <directory>${mardexas.build.directory}</directory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <release>25</release>
          <compilerArgs>
            <!-- ViewModel-Paket der Bibliothek ist nicht exportiert; wird für die
                 Absatz-Analyse im Enter-Handler und für Writer/Parser benötigt.
                 m2e übernimmt das Flag automatisch in die Eclipse-Konfiguration. -->
            <arg>--add-exports=com.gluonhq.richtextarea/com.gluonhq.richtextarea.viewmodel=RichMarkDownEditor</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <!-- Tests laufen auf dem Classpath (TestFX/Monocle sind Automatic-Modules) -->
          <useModulePath>false</useModulePath>
          <!-- Parallele Testausführung über mehrere JVM-Forks (JavaFX/TestFX nicht threadsicher,
               daher forkCount statt parallel=methods/classes) -->
          <forkCount>${test.forkCount}</forkCount>
          <reuseForks>true</reuseForks>
          <excludedGroups>performance</excludedGroups>
          <systemPropertyVariables>
            <prism.order>sw</prism.order>
            <prism.text>t2k</prism.text>
            <java.awt.headless>true</java.awt.headless>
            <testfx.robot>glass</testfx.robot>
            <glass.platform>Monocle</glass.platform>
            <monocle.platform>Headless</monocle.platform>
            <!-- Render office-sized windows inside an explicit virtual desktop. -->
            <headless.geometry>1600x1000-32</headless.geometry>
            <!-- JavaFX-Cache in ein beschreibbares Verzeichnis lenken -->
            <javafx.cachedir>${project.build.directory}/javafx-cache</javafx.cachedir>
            <java.util.prefs.userRoot>${project.build.directory}/test-prefs-${surefire.forkNumber}</java.util.prefs.userRoot>
            <rme.config.dir>${project.build.directory}/test-config-${surefire.forkNumber}</rme.config.dir>
            <perf.outputDirectory>${project.build.directory}/performance</perf.outputDirectory>
          </systemPropertyVariables>
          <argLine>@{argLine} -Djava.io.tmpdir=${project.build.directory}</argLine>
        </configuration>
      </plugin>
      <!-- Statische Codeanalyse: Codierungsstandards (Checkstyle), Bug-Muster (SpotBugs) und
           Testabdeckung (JaCoCo) im Maven-Build verankert (Phase 2). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <sourceDirectories>
            <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
            <sourceDirectory>${project.basedir}/src/test/java</sourceDirectory>
          </sourceDirectories>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-validate</id>
            <!-- Checkstyle runs in Maven; no incremental IDE build action is needed. -->
            <?m2e ignore?>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.10.5.0</version>
        <configuration>
          <failOnError>true</failOnError>
          <threshold>Medium</threshold>
          <effort>Default</effort>
          <excludeFilterFile>spotbugs-suppressions.xml</excludeFilterFile>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit implementation="org.jacoco.report.check.Limit">
                      <counter>LINE</counter>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${mainClass}</mainClass>
          <options>
            <!-- ViewModel-Paket der Bibliothek ist nicht exportiert -->
            <option>--add-exports=com.gluonhq.richtextarea/com.gluonhq.richtextarea.viewmodel=RichMarkDownEditor</option>
            <!-- JavaFX-Native-Cache in ein beschreibbares Verzeichnis lenken -->
            <option>-Djavafx.cachedir=${project.build.directory}/javafx-cache</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>performance</id>
      <properties>
        <jacoco.skip>true</jacoco.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>performance</groups>
              <excludedGroups>none</excludedGroups>
              <forkCount>1</forkCount>
              <reuseForks>false</reuseForks>
              <systemPropertyVariables>
                <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- One executable FAT JAR per host architecture. Native libraries with
         identical paths (notably Intel/ARM macOS) must never be shaded together. -->
    <profile>
      <id>fatjar</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <!-- Thin JAR (RichMarkDownEditor-<version>.jar) bleibt für
                       jpackage erhalten; das FAT-JAR entsteht zusätzlich als
                       RichMarkDownEditor-<version>-fat.jar und wird vom
                       Build-Skript mit explizitem Plattformnamen nach dist/ kopiert. -->
                  <shadedArtifactAttached>true</shadedArtifactAttached>
                  <shadedClassifierName>fat</shadedClassifierName>
                  <createDependencyReducedPom>false</createDependencyReducedPom>
                  <transformers>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>de.richmarkdown.Launcher</mainClass>
                    </transformer>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                  </transformers>
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <exclude>module-info.class</exclude>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                      </excludes>
                    </filter>
                  </filters>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
