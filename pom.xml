<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>de.richmarkdown</groupId>
  <artifactId>Mardexas</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Mardexas</name>
  <description>Mardexas (RichMarkDownEditor) — desktop Markdown editor with a rich-text WYSIWYG interface for Linux, Windows, and macOS. Write Markdown visually and save UTF-8 CommonMark/GFM files. Built with JavaFX 25.</description>
  <url>https://github.com/RainerGa/Mardexas</url>
  <scm>
    <connection>scm:git:https://github.com/RainerGa/Mardexas.git</connection>
    <developerConnection>scm:git:https://github.com/RainerGa/Mardexas.git</developerConnection>
    <url>https://github.com/RainerGa/Mardexas</url>
    <tag>HEAD</tag>
  </scm>
  <licenses>
    <license>
      <name>GNU General Public License v3.0</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Rainer Garbotz</name>
    </developer>
  </developers>

  <modules>
    <module>editor</module>
  </modules>

  <profiles>
    <profile>
      <id>include-rich-text-area-module</id>
      <activation>
        <file>
          <!-- The rich-text-area Maven module lives in a git submodule.
               Only include it in the reactor when the submodule has been
               checked out, so `mvn validate` (e.g. dependency submission)
               succeeds even when the submodule is not initialized. -->
          <exists>rich-text-area/rta/pom.xml</exists>
        </file>
      </activation>
      <modules>
        <module>rich-text-area/rta</module>
      </modules>
    </profile>
  </profiles>
</project>
