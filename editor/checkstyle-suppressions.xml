<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- I18n-Properties-Dateien enthalten lange, einzeilige Übersetzungen und
         sollen nicht vom Java-Style-Check erfasst werden. -->
    <files matches=".*\.properties$"/>
</suppressions>
